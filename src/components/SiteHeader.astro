---
import { Image } from "astro:assets";
import Container from "./ui/Container.astro";
import logo from "../assets/brand/logo.png";

const links = [
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== "/" && path.startsWith(href);
---

<header class="site-header" data-site-header>
  <Container class="inner">
    <a href="/" class="name">
      <Image
        src={logo}
        alt="Mike Faudel, home"
        width={96}
        height={77}
        format="png"
        loading="eager"
      />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</header>

<script>
  /*
   * Hides the header while scrolling down and brings it back on any scroll up,
   * so long pages keep the full screen but the menu is always one flick away.
   * At the top of the page it stays transparent; once scrolled, it gets a backdrop.
   */
  const MIN_DELTA = 8; // ignore tiny scroll jitters

  let lastY = window.scrollY;
  let frame = 0;

  const update = () => {
    frame = 0;
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    if (!header) return;
    const y = Math.max(window.scrollY, 0);
    const delta = y - lastY;
    const past = y > header.offsetHeight;

    header.toggleAttribute("data-solid", past);
    if (!past) header.removeAttribute("data-hidden");
    else if (delta > MIN_DELTA && !header.contains(document.activeElement)) header.setAttribute("data-hidden", "");
    else if (delta < -MIN_DELTA) header.removeAttribute("data-hidden");

    if (Math.abs(delta) > MIN_DELTA || !past) lastY = y;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!frame) frame = requestAnimationFrame(update);
    },
    { passive: true },
  );
  document.addEventListener("astro:page-load", () => {
    lastY = window.scrollY;
    update();
  });
</script>

<style>
  /* Transparent at the top so the ambient background shows through; sticky so it can return on scroll up. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    transition:
      transform var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .site-header[data-solid] {
    background: var(--color-header-bg);
    backdrop-filter: blur(12px);
  }

  .site-header[data-hidden] {
    transform: translateY(-100%);
  }

  .site-header :global(.inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: var(--header-height);
  }

  .name {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-strong);
    text-decoration: none;
  }

  /* The logo is a black shape with a thin white edge, so it reads as an outline on dark backgrounds. */
  .name :global(img) {
    width: 3rem;
    height: auto;
    transition: transform var(--duration-spring) var(--ease-spring);
  }

  /* Playful tilt on hover, matching the Framer site. */
  .name:hover :global(img),
  .name:focus-visible :global(img) {
    transform: rotate(2deg) skewX(-5deg);
  }

  ul {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-base);
    transition: color var(--duration-fast) var(--ease-out);
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-text-strong);
  }

  /* Phones: 44px-tall tap targets and an underline on the current page. */
  @media (width < 48rem) {
    ul {
      gap: var(--space-2xs);
    }

    nav a {
      display: inline-block;
      padding: var(--space-xs) var(--space-2xs);
    }

    nav a[aria-current="page"] {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.4em;
    }
  }
</style>
