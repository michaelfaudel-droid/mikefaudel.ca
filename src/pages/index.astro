---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import WorkStack from "../components/patterns/WorkStack.astro";
import ExperienceCard from "../components/patterns/ExperienceCard.astro";
import WordFlip from "../components/ui/WordFlip.astro";
import { experience } from "../data/experience";
import mark from "../assets/brand/mark.png";

// Tells search engines who this site is about (shown in results, linked to LinkedIn).
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Mike Faudel",
  url: "https://www.mikefaudel.ca",
  jobTitle: "Product Designer",
  worksFor: { "@type": "Organization", name: "Microsoft" },
  knowsAbout: ["Product design", "UX design", "Enterprise AI", "Design systems"],
  sameAs: ["https://www.linkedin.com/in/mikefaudel/"],
};

// Shown in order, quickly, before landing on "effortless".
const taglineWords = [
  "intuitive",
  "human",
  "simple",
  "natural",
  "approachable",
  "trustworthy",
  "clear",
  "calm",
  "familiar",
  "seamless",
  "obvious",
  "delightful",
  "easy",
];
---

<BaseLayout
  description="Product designer at Microsoft specializing in enterprise AI tooling. Case studies from Copilot Studio and Nuance Mix on making complex AI feel effortless."
  ambient="animated"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(person)}
    slot="head"
  />
  <section class="hero">
    <Container width="feature">
      <div>
        <h1 class="display">
          <span class="first-name">
            Mike
            <Image
              class="mark"
              src={mark}
              alt=""
              width={228}
              height={228}
              format="png"
              loading="eager"
            />
          </span>
          Faudel
        </h1>
        <p class="tagline">Making complex AI feel <WordFlip words={taglineWords} final="effortless" /></p>
      </div>
    </Container>
  </section>

  <section class="section">
    <Container width="feature">
      <SectionHeading>Case studies</SectionHeading>
      <WorkStack featuredOnly />
    </Container>
  </section>

  <section class="section">
    <Container width="feature">
      <SectionHeading>Experience</SectionHeading>
      <ul class="experience">
        {experience.map(({ role, company, years, logo, summary }) => (
          <ExperienceCard
            role={role}
            company={company}
            years={years}
            logo={logo}
            description={summary}
          />
        ))}
      </ul>
    </Container>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-section) var(--space-3xl);
  }

  .display {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--weight-regular);
    text-transform: uppercase;
  }

  .first-name {
    display: flex;
    align-items: center;
    gap: 0.15em;
  }

  /* Sized in em so the mark always matches the height of the name. */
  .hero :global(.mark) {
    width: 0.87em;
    height: 0.87em;
  }

  .tagline {
    margin-top: var(--space-md);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .section {
    padding-block: var(--space-3xl);
  }

  .experience {
    display: grid;
    gap: var(--space-lg);
    list-style: none;
    padding: 0;
  }
</style>
