---
/*
 * Fixed page backdrop: drifting soft circles with a grain tile on top.
 * The softness is drawn into the canvas (feathered circles, faded edges) rather
 * than a CSS blur filter, which iOS Safari sometimes skips on large elements.
 */
interface Props {
  animated?: boolean;
}

const { animated = true } = Astro.props;
---

<div class="ambient" aria-hidden="true">
  {animated && <canvas class="circles" data-ambient-canvas />}
  <div class="grain"></div>
</div>

<script>
  const COUNT = 23;
  const MIN_RADIUS = 60;
  const MAX_RADIUS = 240;
  const MAX_SPEED = 72; // px per second
  const FRAME_MS = 1000 / 30;

  const random = (min: number, max: number) => min + Math.random() * (max - min);

  function start(canvas: HTMLCanvasElement) {
    const context = canvas.getContext("2d");
    if (!context) return;

    const styles = getComputedStyle(document.documentElement);
    const blur = parseFloat(styles.getPropertyValue("--ambient-blur")) || 57;
    const base = styles.getPropertyValue("--ambient-base").trim();

    // Normalise each colour to #rrggbb so a fully transparent version can be made for gradients.
    const toHex = (color: string) => {
      context.fillStyle = color;
      return context.fillStyle;
    };
    const palette = [1, 2, 3, 4, 5, 6].map((n) =>
      toHex(styles.getPropertyValue(`--ambient-${n}`).trim()),
    );

    // The canvas is larger than the drifting area by `fade` on every side (see CSS).
    const fade = blur * 2;
    let width = 0;
    let height = 0;
    const resize = () => {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
      width = canvas.width - fade * 2;
      height = canvas.height - fade * 2;
    };
    resize();

    const circles = Array.from({ length: COUNT }, (_, index) => {
      const angle = random(0, Math.PI * 2);
      const speed = random(0.4, 1) * MAX_SPEED;
      return {
        x: random(0, width),
        y: random(0, height),
        radius: random(MIN_RADIUS, MAX_RADIUS),
        color: palette[index % palette.length],
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
      };
    });

    // A feathered disc: solid in the middle, fading out over about two blur radii,
    // and fainter overall when the circle is small (as a real blur would make it).
    const drawSoftCircle = (x: number, y: number, radius: number, color: string) => {
      const outer = radius + blur * 2;
      const solid = Math.max(radius - blur, 0) / outer;
      const strength = Math.min(radius / (blur * 1.5), 1);
      const alpha = Math.round(strength * 255).toString(16).padStart(2, "0");
      const gradient = context.createRadialGradient(x, y, 0, x, y, outer);
      gradient.addColorStop(0, color + alpha);
      gradient.addColorStop(solid, color + alpha);
      gradient.addColorStop(1, color + "00");
      context.fillStyle = gradient;
      context.fillRect(x - outer, y - outer, outer * 2, outer * 2);
    };

    const draw = () => {
      context.fillStyle = base;
      context.fillRect(0, 0, canvas.width, canvas.height);
      for (const { x, y, radius, color } of circles) drawSoftCircle(x + fade, y + fade, radius, color);
    };

    const step = (seconds: number) => {
      for (const circle of circles) {
        // Nudge the heading so each circle wanders instead of travelling straight.
        const turn = random(-0.6, 0.6) * seconds;
        const { vx, vy } = circle;
        circle.vx = vx * Math.cos(turn) - vy * Math.sin(turn);
        circle.vy = vx * Math.sin(turn) + vy * Math.cos(turn);
        circle.x += circle.vx * seconds;
        circle.y += circle.vy * seconds;

        const margin = circle.radius;
        if (circle.x < -margin) circle.x = width + margin;
        if (circle.x > width + margin) circle.x = -margin;
        if (circle.y < -margin) circle.y = height + margin;
        if (circle.y > height + margin) circle.y = -margin;
      }
    };

    window.addEventListener("resize", resize);
    draw();

    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let last = performance.now();
    let frame = 0;
    const tick = (now: number) => {
      frame = requestAnimationFrame(tick);
      const elapsed = now - last;
      if (elapsed < FRAME_MS) return;
      last = now;
      step(Math.min(elapsed, 100) / 1000);
      draw();
    };
    frame = requestAnimationFrame(tick);

    document.addEventListener(
      "astro:before-swap",
      () => {
        cancelAnimationFrame(frame);
        window.removeEventListener("resize", resize);
      },
      { once: true },
    );
  }

  // Runs on first load and after every client-side page change.
  document.addEventListener("astro:page-load", () => {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-ambient-canvas]");
    if (canvas) start(canvas);
  });
</script>

<style>
  .ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  /*
   * The drifting area is 85% wide and --ambient-height tall, centred. The canvas
   * extends past it by two blur radii on each side, and a mask fades those
   * margins out, giving the same soft edge a blur would.
   */
  .circles {
    --fade: calc(var(--ambient-blur) * 2);

    position: absolute;
    top: calc(50% - var(--ambient-height) / 2 - var(--fade));
    left: calc(7.5% - var(--fade));
    width: calc(85% + 2 * var(--fade));
    height: calc(var(--ambient-height) + 2 * var(--fade));
    mask-image:
      linear-gradient(
        to right,
        transparent,
        var(--black) calc(2 * var(--fade)),
        var(--black) calc(100% - 2 * var(--fade)),
        transparent
      ),
      linear-gradient(
        to bottom,
        transparent,
        var(--black) calc(2 * var(--fade)),
        var(--black) calc(100% - 2 * var(--fade)),
        transparent
      );
    mask-composite: intersect;
  }

  .grain {
    position: absolute;
    inset: 0;
    background-image: url("/grain.png");
    background-size: 128px;
    opacity: var(--grain-opacity);
  }
</style>
