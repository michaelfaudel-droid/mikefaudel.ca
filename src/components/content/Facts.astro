---
/*
 * Company facts as a narrow sidebar. Put the section that sits beside it
 * (e.g. "## Challenge" and its paragraphs) between the tags; on small
 * screens the facts stack above it.
 */
interface Props {
  title?: string;
  items: { label: string; value: string }[];
}

const { title, items } = Astro.props;
const hasMain = Astro.slots.has("default");
---

<section class:list={["facts", { "with-main": hasMain }]}>
  <aside class="sidebar">
    {title && <h3>{title}</h3>}
    <dl>
      {items.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </aside>
  {hasMain && (
    <div class="main">
      <slot />
    </div>
  )}
</section>

<style>
  .facts.with-main {
    display: grid;
    grid-template-columns: 14.75rem minmax(0, 1fr);
    gap: var(--space-lg);
    align-items: start;
  }

  h3 {
    margin: 0 0 var(--space-md);
  }

  dl {
    display: grid;
    gap: var(--space-md);
  }

  dt {
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  dd {
    margin-top: var(--space-2xs);
    color: var(--color-text-muted);
  }

  .main > :global(* + *) {
    margin-top: var(--space-sm);
  }

  .main > :global(:first-child) {
    margin-top: 0;
  }

  @media (width < 48rem) {
    .facts.with-main {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
