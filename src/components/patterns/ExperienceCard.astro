---
/* One role as a card: logo, role and company with dates on the right, description below. */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  role: string;
  company: string;
  years: string;
  logo?: ImageMetadata;
  description?: string;
}

const { role, company, years, logo, description } = Astro.props;
---

<li class="card">
  <div class="header">
    <div class="logo">{logo && <Image src={logo} alt="" width={96} height={96} />}</div>
    <div class="title">
      <h3>{role}</h3>
      <p class="company">{company}</p>
    </div>
    <p class="years">{years}</p>
  </div>
  {description && <p class="description">{description}</p>}
</li>

<style>
  .card {
    padding: var(--space-sm) var(--space-md) var(--space-md);
    border-radius: var(--radius-md);
    background: var(--color-surface-card);
  }

  .header {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: var(--space-sm);
  }

  .logo {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--color-surface-raised);
  }

  .logo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
  }

  .company,
  .years {
    font-weight: var(--weight-medium);
    color: var(--color-text);
  }

  .description {
    margin-top: var(--space-md);
    max-width: var(--width-about-text);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
  }

  @media (width < 36rem) {
    .header {
      grid-template-columns: 2.5rem 1fr;
    }

    .years {
      grid-column: 2;
    }
  }
</style>
