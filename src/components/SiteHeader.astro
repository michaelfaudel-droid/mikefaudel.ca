---
import { Image } from "astro:assets";
import Container from "./ui/Container.astro";
import logo from "../assets/brand/logo.png";

const links = [
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "mailto:michaelfaudel@gmail.com", label: "Contact" },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) => href !== "/" && path.startsWith(href);
---

<header class="site-header">
  <Container class="inner">
    <a href="/" class="name">
      <Image
        src={logo}
        alt="Mike Faudel, home"
        width={96}
        height={77}
        format="png"
        loading="eager"
      />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</header>

<style>
  /* Transparent and scrolls with the page, so the ambient background shows through. */
  .site-header {
    position: relative;
    z-index: 5;
  }

  .site-header :global(.inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: 4rem;
  }

  .name {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-strong);
    text-decoration: none;
  }

  /* The logo is a black shape with a thin white edge, so it reads as an outline on dark backgrounds. */
  .name :global(img) {
    width: 3rem;
    height: auto;
    transition: transform var(--duration-spring) var(--ease-spring);
  }

  /* Playful tilt on hover, matching the Framer site. */
  .name:hover :global(img),
  .name:focus-visible :global(img) {
    transform: rotate(2deg) skewX(-5deg);
  }

  ul {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--text-base);
    transition: color var(--duration-fast) var(--ease-out);
  }

  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--color-text-strong);
  }

  @media (width < 30rem) {
    ul {
      gap: var(--space-sm);
    }
  }
</style>
