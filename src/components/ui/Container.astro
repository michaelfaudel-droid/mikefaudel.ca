---
interface Props {
  width?: "content" | "prose";
  class?: string;
}

const { width = "content", class: className } = Astro.props;
---

<div class:list={["container", `container--${width}`, className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .container--content {
    max-width: calc(var(--width-content) + 2 * var(--gutter));
  }

  .container--prose {
    max-width: calc(var(--width-prose) + 2 * var(--gutter));
  }
</style>
