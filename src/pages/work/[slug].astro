---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import Tag from "../../components/ui/Tag.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, company, role, year, tags, tint } = entry.data;
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="header" style={`--header-tint: var(--tint-${tint})`}>
      <Container>
        <p class="meta">{company} · {role} · {year}</p>
        <h1>{title}</h1>
        <p class="summary">{summary}</p>
        <div class="tags">{tags.map((tag) => <Tag>{tag}</Tag>)}</div>
      </Container>
    </header>
    <Container width="prose">
      <div class="prose">
        <Content />
      </div>
    </Container>
  </article>
</BaseLayout>

<style>
  .header {
    padding-block: var(--space-section) var(--space-2xl);
    margin-bottom: var(--space-2xl);
    background: linear-gradient(to bottom, var(--header-tint), var(--color-bg));
  }

  .meta {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-sm);
  }

  .summary {
    margin-top: var(--space-md);
    max-width: var(--width-prose);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }
</style>
