---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import WorkGrid from "../../components/patterns/WorkGrid.astro";
---

<BaseLayout title="Work">
  <Container class="page">
    <SectionHeading as="h1" eyebrow="Work">
      Case studies
    </SectionHeading>
    <p class="lead">
      UX/UI design at scale for enterprise SaaS platforms, with deep expertise in generative AI
      software. Currently a product designer at Microsoft.
    </p>
    <WorkGrid />
  </Container>
</BaseLayout>

<style>
  :global(.page) {
    padding-top: var(--space-section);
  }

  .lead {
    max-width: var(--width-prose);
    margin-bottom: var(--space-xl);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>
