---
/* A row of customer logos. Wrap Markdown images in it. */
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<section class="logo-grid">
  {title && <h3>{title}</h3>}
  <slot />
</section>

<style>
  .logo-grid :global(p) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
    gap: var(--space-md) var(--space-lg);
    align-items: center;
  }

  .logo-grid :global(img) {
    max-height: 2.5rem;
    width: auto;
    margin-inline: auto;
    opacity: 0.7;
  }
</style>
