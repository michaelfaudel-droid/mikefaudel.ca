---
import Container from "./ui/Container.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <a class="contact" href="mailto:michaelfaudel@gmail.com">
      Get in touch
    </a>
    <div class="bottom">
      <p>© {year} Mike Faudel</p>
      <ul>
        <li>
          <a href="https://www.linkedin.com/in/mikefaudel/" rel="me">
            LinkedIn
          </a>
        </li>
        <li>
          <a href="mailto:michaelfaudel@gmail.com">Mail</a>
        </li>
      </ul>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-section);
    padding-top: var(--space-section);
    padding-bottom: var(--space-xl);
    background: radial-gradient(ellipse at 50% 40%, var(--tint-blue), var(--color-bg) 70%);
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
  }

  .contact {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-strong);
    text-decoration: none;
    text-align: center;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .contact:hover {
    opacity: 0.8;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-section);
  }

  ul {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  .bottom a {
    text-decoration: none;
  }

  .bottom a:hover {
    color: var(--color-text-strong);
  }
</style>
