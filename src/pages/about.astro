---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import ExperienceRow from "../components/patterns/ExperienceRow.astro";
import Button from "../components/ui/Button.astro";
import { experience } from "../data/experience";
import portrait from "../assets/about/portrait.png";
---

<BaseLayout title="About">
  <Container width="feature" class="page">
    <div class="intro">
      <Image
        class="portrait"
        src={portrait}
        alt="Illustrated portrait of Mike Faudel"
        widths={[160, 320, 480]}
        sizes="9rem"
        loading="eager"
      />
      <div>
        <h1 class="hi">Hi. <span class="wave" aria-hidden="true">👋</span></h1>
        <div class="prose">
          <p>
            I'm a product designer specializing in enterprise AI tooling, the kind of complex,
            high-stakes products where clarity and trust aren't nice-to-haves, they're the whole
            job. At Microsoft, I’m design owner for key areas of Copilot Studio, shaping how
            enterprises build and deploy AI agents at scale across a platform used by 230,000+
            organizations, including 90% of the Fortune 500. Before that, I led feature design at
            Nuance on a conversational AI platform used by Fortune 500 companies across healthcare,
            retail, and customer service.
          </p>
          <p>
            I work best in ambiguous spaces where the problem isn't fully defined yet, partnering
            closely with product and engineering to figure out what to build, not just how to design
            it.
          </p>
          <p>
            When I'm not Microsofting, I'm vibe coding apps, playing with my daughter, making music,
            or doing graphic and video design for passion projects.
          </p>
        </div>
        <div class="resume">
          <Button href="/mike-faudel-resume.pdf" variant="secondary" download="Mike Faudel resume.pdf">
            Download resume
          </Button>
        </div>
      </div>
    </div>

    <section class="section">
      <SectionHeading>Experience</SectionHeading>
      <ul class="experience">
        {experience.map(({ role, company, years, logo, detail }) => (
          <ExperienceRow
            role={role}
            company={company}
            years={years}
            logo={logo}
            description={detail}
          />
        ))}
      </ul>
    </section>
  </Container>
</BaseLayout>

<style>
  :global(.page) {
    padding-top: var(--space-section);
  }

  .intro {
    display: grid;
    grid-template-columns: 12rem minmax(0, var(--width-about-text));
    gap: var(--space-lg);
    align-items: start;
  }

  /* Fades in after the page loads, then lifts and tilts on hover (matching the Framer site). */
  .intro :global(.portrait) {
    width: 100%;
    height: 9rem;
    object-fit: contain;
    opacity: 0.83;
    animation: portrait-in var(--duration-slower) var(--ease-in-out) 0.5s backwards;
    transition:
      transform var(--duration-pop) var(--ease-pop),
      opacity var(--duration-pop) var(--ease-pop);
  }

  .intro :global(.portrait:hover) {
    opacity: 1;
    transform: rotate(1deg) rotateX(7deg) rotateY(13deg) scale(1.1);
  }

  @keyframes portrait-in {
    from {
      opacity: 0;
    }
  }

  .hi {
    margin-bottom: var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: var(--weight-medium);
  }

  .wave {
    display: inline-block;
    transition: transform var(--duration-spring) var(--ease-in-out);
  }

  .wave:hover {
    transform: rotate(20deg) scale(1.1);
  }

  .resume {
    margin-top: var(--space-lg);
  }

  .section {
    padding-top: var(--space-section);
  }

  .experience {
    list-style: none;
    padding: 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  @media (width < 48rem) {
    .intro {
      grid-template-columns: 1fr;
    }

    .intro :global(.portrait) {
      width: 9rem;
    }
  }
</style>
