---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
import SectionHeading from "../../components/ui/SectionHeading.astro";
import ShineChip from "../../components/ui/ShineChip.astro";
import WorkStack from "../../components/patterns/WorkStack.astro";
---

<BaseLayout
  title="Work"
  description="Case studies by Mike Faudel: UX/UI design at scale for enterprise SaaS and generative AI, including Microsoft Copilot Studio and Nuance Mix."
  ambient="animated"
>
  <Container width="feature" class="page">
    <SectionHeading as="h1">
      Case studies
    </SectionHeading>
    <WorkStack />

    <p class="expertise">
      Expert in <ShineChip text="UX/UI design" /> with an emphasis on designing at scale for{" "}
      <ShineChip text="Enterprise SaaS" /> platforms, with deep expertise in{" "}
      <ShineChip text="Generative AI" /> software. Currently a{" "}
      <ShineChip text="Product Designer" /> at Microsoft.
    </p>
  </Container>
</BaseLayout>

<style>
  :global(.page) {
    padding-top: var(--space-section);
  }

  .expertise {
    max-width: 44rem;
    margin: var(--space-section) auto 0;
    font-size: var(--text-lg);
    line-height: 2.4;
    text-align: center;
    color: var(--color-text-strong);
  }
</style>
