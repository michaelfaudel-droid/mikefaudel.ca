---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, company, role, duration, tint, cover } = entry.data;
// Shared links preview this case study's cover rather than the site-wide image.
const preview = await getImage({ src: cover, width: 1200, format: "jpg" });
---

<BaseLayout title={title} description={summary} image={preview.src}>
  <article>
    <header class="header" style={`--header-tint: var(--tint-${tint})`}>
      <Container width="feature" class="reading">
        <p class="meta">{company}</p>
        <h1>{title}</h1>
        <dl class="details">
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          {duration !== "TODO" && (
            <div>
              <dt>Duration</dt>
              <dd>{duration}</dd>
            </div>
          )}
        </dl>
      </Container>
    </header>
    <Container width="feature">
      <div class="prose case-body">
        <Content />
      </div>
    </Container>
  </article>
</BaseLayout>

<style>
  /*
   * Text sits in a centred reading column; images and galleries span the full
   * site column, so their edges line up with the cards on Home and Work.
   */
  .header :global(.reading) > *,
  .case-body > :global(*) {
    max-width: var(--width-reading);
    margin-inline: auto;
  }

  .case-body > :global(p:has(img)),
  .case-body > :global(.gallery) {
    max-width: none;
  }

  /* Starts behind the transparent site header so the tint shows through it. */
  .header {
    margin-top: calc(-1 * var(--header-height));
    padding-block: calc(var(--space-section) + var(--header-height)) var(--space-2xl);
    margin-bottom: var(--space-xl);
    background: linear-gradient(to bottom, var(--header-tint), var(--color-bg));
  }

  h1 {
    font-size: var(--text-title);
  }

  .case-body {
    font-size: var(--text-reading);
  }

  .meta {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-sm);
  }

  .details {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
  }

  dt {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-subtle);
  }

  dd {
    margin-top: var(--space-3xs);
    color: var(--color-text);
  }
</style>
