---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  summary: string;
  company: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  stats?: { value: string; label: string }[];
  tint?: "blue" | "purple" | "green" | "brown" | "red";
}

const {
  href,
  title,
  summary,
  company,
  cover,
  coverAlt = "",
  stats = [],
  tint = "blue",
} = Astro.props;
---

<a href={href} class="card" style={`--card-tint: var(--tint-${tint})`}>
  <div class="media">
    {cover && (
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 60rem) 36rem, 100vw"
      />
    )}
  </div>
  <div class="body">
    <p class="company">{company}</p>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    {stats.length > 0 && (
      <dl class="stats">
        {stats.map(({ value, label }) => (
          <div>
            <dt>{value}</dt>
            <dd>{label}</dd>
          </div>
        ))}
      </dl>
    )}
    <span class="cta">View case study →</span>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--space-md);
    padding: var(--space-sm);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    text-decoration: none;
    transition:
      transform var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .card:hover {
    transform: translateY(-4px);
    border-color: var(--color-text-subtle);
  }

  .media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-md);
    background: var(--card-tint);
    overflow: hidden;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .card:hover .media :global(img) {
    transform: scale(1.03);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0 var(--space-2xs) var(--space-2xs);
  }

  .company {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .summary {
    color: var(--color-text-muted);
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    margin-block: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: var(--border-width) solid var(--color-border);
  }

  dt {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text-strong);
  }

  dd {
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .cta {
    margin-top: auto;
    font-size: var(--text-sm);
    color: var(--color-text-strong);
  }
</style>
