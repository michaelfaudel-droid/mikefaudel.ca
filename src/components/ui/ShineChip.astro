---
/*
 * A keyword in a pill, with a light that sweeps across the text and the border
 * every few seconds (matching the Framer site). The sweep is a CSS-generated
 * copy of the text, so the word appears only once in the page's text.
 */
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="chip"><span class="label" data-text={text}>{text}</span></span>

<style>
  .chip {
    position: relative;
    display: inline-block;
    padding: 0.25rem var(--space-sm);
    border: var(--border-width) solid var(--chip-border);
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: var(--text-reading);
    line-height: var(--leading-normal);
    white-space: nowrap;
    vertical-align: middle;
  }

  .label {
    position: relative;
    color: var(--chip-text);
  }

  /* Text and border share one sweep: a bright band that slides from right to left. */
  .label::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--chip-text-shine);
    text-shadow: 0 0 3px var(--chip-text-shine);
    mask-image: linear-gradient(to right, transparent 30%, var(--black) 50%, transparent 70%);
    mask-size: 150% auto;
    animation: chip-shine var(--duration-shine) ease-in-out infinite;
  }

  /* The border's band is also cut down to a 1px ring (padding box minus content box). */
  .chip::before {
    content: "";
    position: absolute;
    inset: calc(-1 * var(--border-width));
    padding: var(--border-width);
    border-radius: inherit;
    background: var(--chip-shine);
    mask-image:
      linear-gradient(to right, transparent 30%, var(--black) 50%, transparent 70%),
      linear-gradient(var(--black) 0 0),
      linear-gradient(var(--black) 0 0);
    mask-clip: border-box, content-box, border-box;
    mask-size:
      150% auto,
      auto,
      auto;
    mask-composite: intersect, exclude;
    pointer-events: none;
    animation: chip-shine var(--duration-shine) ease-in-out infinite;
  }

  @keyframes chip-shine {
    from {
      mask-position: 200% center;
    }

    to {
      mask-position: -100% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .label::after,
    .chip::before {
      animation: none;
      opacity: 0;
    }
  }
</style>
