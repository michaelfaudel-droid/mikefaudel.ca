---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import CopyButton from "../components/ui/CopyButton.astro";

const email = "michaelfaudel@gmail.com";
---

<BaseLayout title="Contact" ambient="animated">
  <Container width="feature" class="page">
    <!-- "uch" slides in from the right, bumps into "to", then springs back into place. -->
    <h1>Get in <span class="touch">to<span class="uch">uch</span></span></h1>

    <p class="email">{email}</p>
    <div class="actions">
      <CopyButton value={email} label="Copy email" />
      <Button href={`mailto:${email}`} variant="secondary">Open in mail app</Button>
    </div>

    <p class="elsewhere">
      Or find me on <a href="https://www.linkedin.com/in/mikefaudel/" rel="me">LinkedIn</a>.
    </p>
  </Container>
</BaseLayout>

<style>
  :global(.page) {
    padding-top: var(--space-section);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .email {
    margin-top: var(--space-xl);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-text-strong);
    overflow-wrap: anywhere;
  }

  .touch {
    white-space: nowrap;
  }

  .uch {
    display: inline-block;
    animation: uch-in 1.1s 0.3s backwards;
  }

  /* Accelerates in, collides so the "u" touches the "o", then springs back to rest. */
  @keyframes uch-in {
    0% {
      opacity: 0;
      transform: translateX(0.6em);
      animation-timing-function: cubic-bezier(0.5, 0, 0.9, 0.6);
    }

    20% {
      opacity: 1;
    }

    50% {
      /* The "o" to "u" gap in Lexend Deca is 0.062em, so this just closes it. */
      transform: translateX(-0.065em);
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.4, 1);
    }

    72% {
      transform: translateX(0.04em);
      animation-timing-function: ease-in-out;
    }

    86% {
      transform: translateX(-0.01em);
      animation-timing-function: ease-in-out;
    }

    100% {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .uch {
      animation: none;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .elsewhere {
    margin-top: var(--space-xl);
    color: var(--color-text-muted);
  }

  .elsewhere a {
    color: var(--color-text-strong);
  }
</style>
